# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Variabel berawalan NEXT_PUBLIC_ ikut terkirim ke browser: jangan untuk rahasia.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA. Melewati RLS. Hanya dipakai di route API publik.
SUPABASE_SERVICE_ROLE_KEY=

# --- Midtrans (Settings > Access Keys). Sandbox dulu ---
# RAHASIA
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# false = Sandbox, true = Production
MIDTRANS_IS_PRODUCTION=false

# --- Email lewat SMTP Gmail (Nodemailer) ---
# Aktifkan verifikasi 2 langkah di akun Gmail, lalu buat App Password.
GMAIL_USER=
# RAHASIA. App Password 16 karakter, bukan kata sandi Gmail.
GMAIL_APP_PASSWORD=

# --- Lainnya ---
# RAHASIA. Garam untuk hash IP di tabel lookup_attempts. Isi string acak panjang.
IP_HASH_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nomor WhatsApp admin, format internasional tanpa +. Contoh dummy:
NEXT_PUBLIC_ADMIN_WA=6281234567890
